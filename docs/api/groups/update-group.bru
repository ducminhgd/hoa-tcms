}

patch {
  url: {{baseUrl}}/api/v1/groups/{{groupId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "QA Engineers Updated",
    "description": "Updated description",
    "status": "ACTIVE"
  }
}

docs {
  # Update Group

  Partial update of a group. Requires `group:update` permission.

  All fields are optional — only provided fields will be updated.

  - `200 OK`
  - `404 Not Found`
  - `422 Unprocessable Entity` — validation error
}
