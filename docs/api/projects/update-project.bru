body:json {
  {
    "name": "Updated Project Name",
    "description": "Updated description",
    "status": "ACTIVE"
  }
}

docs {
  # Update Project

  Updates project fields. All fields optional; at least one required.
  Requires `project:update` permission AND Owner/Editor role (or System Admin).

  - `200 OK` — project updated
  - `401 Unauthorized` — not authenticated
  - `403 Forbidden` — missing permission or not Owner/Editor
  - `404 Not Found` — project does not exist or is soft-deleted
  - `409 Conflict` — name conflicts with another project
  - `422 Unprocessable Entity` — validation error
}
