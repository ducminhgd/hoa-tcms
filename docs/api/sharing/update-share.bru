meta {
  name: Update Share Role
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/share/1
  body: json
  auth: inherit
}

body:json {
  {
    "role": "Viewer"
  }
}

docs {
  # Update Share Role

  Changes the role on an existing sharing record. Valid roles: Editor, Contributor, Viewer.
  Requires `share:create` permission.

  - `204 No Content` — role updated
  - `403 Forbidden` — missing permission
  - `422 Unprocessable Entity` — invalid role
}
