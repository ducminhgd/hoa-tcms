meta {
  name: Get Test Run Statistics
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/test-runs/1/statistics
  body: none
  auth: inherit
}

docs {
  # Get Test Run Statistics

  Returns aggregated test case result counts from all non-deleted executions under this
  test run: total, not_tested, in_progress, pass, fail, warning, ignore.
  Requires `test_run:read` permission and project membership (any role).

  - `200 OK` — statistics object
  - `403 Forbidden` — missing permission or not a member
  - `404 Not Found` — run not found or soft-deleted
}
