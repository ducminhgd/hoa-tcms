  name: Create Test Run
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/projects/1/test-runs
  body: json
  auth: inherit
}

body:json {
  {
    "summary": "Sprint 12 Regression Run",
    "report_to": 2,
    "default_tester": 3,
    "plan_id": 1,
    "version": "v2.3.1",
    "notes": "Full regression run for build 3.2.1",
    "planned_start_date": "2026-07-20",
    "planned_end_date": "2026-07-25",
    "case_ids": [10, 11, 12]
  }
}

docs {
  # Create Test Run

  Creates a new test run scoped to a project, with optional case assignments and plan linkage.
  Requires `test_run:create` permission and Contributor (or higher) role in the project.

  - `201 Created` — run created, `Location` header set
  - `403 Forbidden` — missing permission or Viewer role
  - `404 Not Found` — project does not exist or is soft-deleted
  - `409 Conflict` — duplicate summary in same project
  - `422 Unprocessable Entity` — validation error (empty summary, invalid plan, invalid date range)
}
