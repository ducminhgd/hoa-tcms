meta {
  name: Manage Test Run Cases
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/test-runs/1/cases
  body: json
  auth: inherit
}

body:json {
  {
    "add_case_ids": [14, 15],
    "remove_case_ids": [12]
  }
}

docs {
  # Manage Test Run Cases

  Adds and/or removes test case assignments on a test run. Both fields are optional.
  Duplicate additions are silently ignored. Requires `test_run:update` permission and
  Contributor (or higher) role.

  - `204 No Content` — cases updated
  - `403 Forbidden` — missing permission or Viewer role
  - `404 Not Found` — run not found or soft-deleted
}
