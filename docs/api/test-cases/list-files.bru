meta {
  name: List Test Case Files
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/projects/1/test-cases/1/files?sort=-created_at
  body: none
  auth: inherit
}

docs {
  # List Test Case Files

  Returns all non-deleted file attachments for a test case. Supports optional `search` (ILIKE
  on file_name) and `sort` parameters. Requires `test_case_file:read` permission and project
  membership (any role).

  - `200 OK` — array of file metadata (excludes file_path)
  - `403 Forbidden` — missing permission or not a project member
  - `404 Not Found` — project or test case not found or soft-deleted
}
