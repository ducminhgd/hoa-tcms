meta {
  name: Download Test Case File
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/projects/1/test-cases/1/files/1
  body: none
  auth: inherit
}

docs {
  # Download Test Case File

  Downloads a file attachment. The response streams the file content with proper
  Content-Type and Content-Disposition headers. Requires `test_case_file:read`
  permission and project membership (any role).

  - `200 OK` — file content with headers (Content-Type, Content-Disposition, Content-Length)
  - `403 Forbidden` — missing permission or not a project member
  - `404 Not Found` — project, test case, or file not found, soft-deleted, or missing from storage
}
