meta {
  name: Select Test Plans
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/test-plans/select
  body: none
  auth: inherit
}

docs {
  # Select Test Plans (Dropdown)

  Returns a compact, unpaginated list of test plans for dropdown/selection UI components.
  Each entry contains only `id` and `name`. Results are capped at 1000. Requires
  `test_plan:select` permission.

  - `200 OK` — array of `{ id, name }` objects
  - `403 Forbidden` — missing permission
}
