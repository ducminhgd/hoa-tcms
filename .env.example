# HOA TCMS — Environment Configuration Template
# Copy this file to .env and adjust for your local environment.

# Server
HOST=0.0.0.0
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgres://tcms:tcms_pass@localhost:5432/hoa_tcms

# Session store (Redis)
REDIS_URL=redis://localhost:6379

# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# File storage
FILE_STORAGE_PATH=./storage/uploads

# Log level (trace, debug, info, warn, error)
RUST_LOG=info

# PBKDF2 iterations (higher = more secure but slower)
PBKDF2_ITERATIONS=600000
